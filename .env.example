# Environment
NODE_ENV=development

# Service Ports
API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
EMPLOYEE_SERVICE_PORT=3002
ATTENDANCE_SERVICE_PORT=3003
LOG_SERVICE_PORT=3004

# Internal Microservice URLs (REST HTTP)
API_GATEWAY_URL=http://localhost:3000
AUTH_SERVICE_URL=http://localhost:3001
EMPLOYEE_SERVICE_URL=http://localhost:3002
ATTENDANCE_SERVICE_URL=http://localhost:3003
LOG_SERVICE_URL=http://localhost:3004

# Databases & Message Broker
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dexa_wfh?schema=public
MONGODB_URI=mongodb://localhost:27017/dexa_wfh_logs
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Security & Uploads
JWT_SECRET=replace-with-strong-jwt-secret
JWT_EXPIRES_IN=8h
INTERNAL_API_KEY=replace-with-internal-service-key
UPLOADS_DIR=./uploads

# Frontend Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# Izinkan origin loopback dan IPv4 privat (LAN) tanpa mendaftarkan IP satu per satu.
# Default: true hanya saat NODE_ENV=development; production default false.
CORS_ALLOW_LAN=true
VITE_API_GATEWAY_URL=http://localhost:3000

# Seed account passwords (lokal/demo saja). Isi dengan pilihan Anda sebelum seed pertama.
# Kosongkan untuk membuat password acak saat seed; nilainya dicetak di log dan tidak disimpan.
SEED_ADMIN_PASSWORD=
SEED_EMPLOYEE_PASSWORD=
# Seed akun demo bersifat opt-in. Set true hanya untuk demo lokal; default false (termasuk production).
SEED_DEMO_USERS=false
